# ==============================================================================
# Development Dockerfile for OmniRecon Frontend (Vue 3 + Vite HMR)
# ==============================================================================

FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

EXPOSE 3000

CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0 --port 3000"]
