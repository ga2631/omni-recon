# ==============================================================================
# OmniRecon Environment Configuration
# ==============================================================================

# Application Environment (development | production | test)
APP_ENV=development
APP_PORT=8080
APP_SECRET=omni-recon-super-secret-key-change-in-production-min32chars

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=omnirecon
POSTGRES_USER=omnirecon
POSTGRES_PASSWORD=omnirecon_secure_password
DATABASE_URL=postgresql://omnirecon:omnirecon_secure_password@postgres:5432/omnirecon?sslmode=disable

# Redis Configuration (Job Queue & Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# DuckDB / File Storage Engine
STORAGE_PATH=./data/storage
DUCKDB_PATH=./data/omnirecon.duckdb
MAX_UPLOAD_SIZE_MB=250

# Log & Monitoring
RUST_LOG=info,omni_recon=debug,tower_http=debug

# Alert Notification Webhooks (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LARK_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
